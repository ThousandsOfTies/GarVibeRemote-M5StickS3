{
  "schema_version": 1,
  "id": "garviberemote-m5sticks3",
  "components": {
    "application": "sources/gar-vibe-remote",
    "tools": "sources/gar-tools",
    "board": "sources/board-m5sticks3"
  },
  "board_profile": "arduino-esp32",
  "hardware": {
    "binding": "hardware/binding.json"
  },
  "application": {
    "device": "m5sticks3",
    "firmware": "gar-sticks3-usb-dev-v1",
    "bluetooth_name": "VibeRemote-StickS3",
    "source_prefix": "m5sticks3",
    "rotation": 0,
    "brightness": 96,
    "lvgl_heap_bytes": 49152
  },
  "build": {
    "backend": "platformio",
    "project": "firmware/sticks3",
    "environment": "sticks3-usb",
    "sources": [
      "vibe-remote/device-app/DeviceApplication.cpp",
      "vibe-remote/compact-ui/CompactUi.cpp"
    ],
    "includes": [
      "vibe-remote/device-app",
      "vibe-remote/compact-ui",
      "vibe-remote/touch-ui"
    ]
  },
  "launch": {
    "entrypoint": "firmware/sticks3/src/main.cpp",
    "simulation": "simulation/host-server.cjs"
  }
}
